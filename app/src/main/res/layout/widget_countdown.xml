<?xml version="1.0" encoding="utf-8"?>
<!--
  倒数日组件布局。

  约束：RemoteViews 只认白名单里的控件，不能用自定义 View、ConstraintLayout，
  连 <View> 都不行（会 InflateException）。所以这里只用 FrameLayout /
  LinearLayout / TextView / ImageButton。

  默认背景透明，文字纯白，靠 shadowColor/shadowRadius 保证在浅色壁纸上也读得清。
  这几个 shadow 属性是布局期静态属性，RemoteViews 完整支持。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/cd_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/cd_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:text="@string/widget_countdown_label"
            android:textColor="@color/widget_text_white"
            android:textSize="14sp" />

        <!-- 单位文字紧跟数字，避免底部再重复一遍「还有 N 天」。 -->
        <LinearLayout
            android:id="@+id/cd_days_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAlignedChildIndex="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cd_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:text="@string/widget_countdown_prefix_remaining"
                android:textColor="@color/widget_text_white"
                android:textSize="13sp" />

            <!-- Provider 按组件尺寸、数字位数、两侧单位和用户字号倍率设置最终文字大小 -->
            <TextView
                android:id="@+id/cd_number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-thin"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="12"
                android:text="@string/widget_countdown_sample_number"
                android:textColor="@color/widget_text_white"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/cd_suffix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:text="@string/widget_countdown_suffix_days"
                android:textColor="@color/widget_text_white"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/cd_deadline"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="12"
            android:textColor="@color/widget_text_white"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cd_repeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textColor="@color/widget_text_white"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/cd_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:padding="16dp"
        android:shadowColor="#B3000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:text="@string/widget_countdown_empty"
        android:textColor="@color/widget_text_white"
        android:textSize="13sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/cd_next"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/widget_countdown_next"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chevron"
        android:visibility="gone" />

</FrameLayout>
